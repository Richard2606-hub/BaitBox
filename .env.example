# ============================================================================
# BaitBox — Trusted Control Plane Configuration
# ============================================================================
# SECURITY NOTE: This file is read ONLY by the control-plane service user on
# the Vultr VM. Never mount or pass these variables into disposable chambers.

# Mode: "production" (uses Vultr Serverless Inference) or "local" (uses deterministic fallback when no API key is set)
BAITBOX_MODE=local

# Vultr Serverless Inference (OpenAI-compatible endpoint)
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_API_KEY=
# Optional model overrides (if blank, discovered automatically from Vultr Model Catalog)
VULTR_PLANNER_MODEL=qwen2.5-coder-32b-instruct
VULTR_VISION_MODEL=qwen2.5-vl-72b-instruct

# Chamber Isolation Settings
# "auto" (uses Docker + gVisor runsc if available, falls back to local sandbox for dev), "docker", or "local"
CHAMBER_BACKEND=auto
CHAMBER_IMAGE=baitbox-chamber:latest
EGRESS_IMAGE=baitbox-egress:latest
CHAMBER_MAX_AGE_SECONDS=90
CHAMBER_SWEEP_INTERVAL_SECONDS=60
CHAMBER_CPU_LIMIT=1.0
CHAMBER_MEM_LIMIT=1g
CHAMBER_PIDS_LIMIT=256

# Agent & Policy Gate Settings
MAX_AGENT_STEPS=8
REQUIRE_APPROVAL_FOR_INTERACTION=false
RETENTION_DAYS=7

# Network & Server Settings
CONTROL_PLANE_HOST=0.0.0.0
CONTROL_PLANE_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
