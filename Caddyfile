# ============================================================================
# BaitBox Caddyfile — Automatic HTTPS Edge Proxy on Vultr Cloud Compute
# ============================================================================
{$BAITBOX_DOMAIN:localhost} {
    encode zstd gzip

    # Security headers for the control plane UI
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "no-referrer"
        Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: http://localhost:8000; connect-src 'self' http://localhost:8000; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval';"
    }

    # Route API, SSE streams, evidence screenshots, and demo trap routes to FastAPI Orchestrator (M2)
    handle /api/* {
        reverse_proxy orchestrator:8000 {
            flush_interval -1
        }
    }

    handle /trap/* {
        reverse_proxy orchestrator:8000
    }

    handle /screenshots/* {
        reverse_proxy orchestrator:8000
    }

    # Route everything else to Next.js Web Console (M1)
    handle {
        reverse_proxy console:3000
    }
}
